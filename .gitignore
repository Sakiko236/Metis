# ==========================================
# Metis - Git Ignore Configuration
# ==========================================

# Sensitive User Config & Private Data (Protects API Keys & Chat Logs)
sessions.json
config.json
metis_config.json
metis_sessions.json
*.local.json
.env
.env.*
*.key
*.pem
*.secret
*.token

# Build Artifacts & Executables
target/
src-tauri/target/
src-tauri/bin/
node_modules/
dist/
*.exe
*.pdb
*.obj
*.log
*.tmp
*.bak

# Runtime Cache & Python Bytecode
__pycache__/
*.py[cod]
*$py.class

# IDE & Editor Temporary Files
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Windows OS Files
Thumbs.db
ehthumbs.db
Desktop.ini
