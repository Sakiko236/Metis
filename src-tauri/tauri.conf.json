{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Metis",
  "version": "../package.json",
  "identifier": "com.sakiko.metis",
  "build": {
    "frontendDist": "../src/frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Metis",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage",
      "dmg"
    ],
    "externalBin": [
      "bin/metis-engine"
    ],
    "shortDescription": "The Laser-Focused File-Centric Micro-Agent",
    "longDescription": "Metis is a laser-focused, file-centric micro-agent designed for surgical code modifications with zero blast radius.",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
